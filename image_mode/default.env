# database connection
POSTGRES_DB=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

BASE_URL=http://localhost:7007

# TLS certificate validation (set to 0 only for development with self-signed certificates)
NODE_TLS_REJECT_UNAUTHORIZED=1

# use development segment key
SEGMENT_WRITE_KEY=gGVM6sYRK0D0ndVX22BOtS7NRcxPej8t
ENABLE_AUTH_PROVIDER_MODULE_OVERRIDE=true



# Backstage log level
# LOG_LEVEL=debug

# Backend auth secret
BACKEND_SECRET=your-backend-secret-key-here-must-be-set
AAP_HOST_URL=https://your-aap-instance.com
AAP_TOKEN=your-aap-token
OAUTH_CLIENT_ID=your-oauth-client-id
OAUTH_CLIENT_SECRET=your-oauth-client-secret

# =============================================================================
# External Integrations
# =============================================================================

# GitHub Integration
# Generate a personal access token at: https://github.com/settings/tokens
# Required scopes: repo, read:org, read:user, user:email
GITHUB_TOKEN=<GITHUB_TOKEN>

# GitLab Integration
# Generate a personal access token at: https://gitlab.com/-/profile/personal_access_tokens
# Required scopes: read_api, read_repository, read_user
GITLAB_TOKEN=<GITLAB_TOKEN>
GITLAB_URL=https://gitlab.com