# VM User Credentials - Edit before building
# These are embedded in the bootc image at BUILD time
#
# SETUP: Copy this file to .credentials.env and edit with your values
#   cp credentials.env.example .credentials.env
#   Edit .credentials.env in your editor
#
# The .credentials.env file is hidden and ignored by git to prevent accidental commits.

# Admin user (default: admin/admin123)
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# Root password (default: root123)
ROOT_PASSWORD=root123

# SSH Public Key (optional, recommended for production)
# IMPORTANT: Copy your public key to quadlet/files/ directory first
# Example: After copying to quadlet/files/, use: SSH_PUBLIC_KEY_FILE=quadlet/files/my_key.pub
SSH_PUBLIC_KEY_FILE=

# SSH Security Mode
# - "keys-and-password" (default) - SSH keys + password fallback
# - "keys-only"                   - SSH keys only (most secure)
# - "password-only"               - Password only (dev/demo only)
SSH_SECURITY_MODE=password-only

# SECURITY: Change these for production. These credentials are embedded
# at build time. Generate strong password: openssl rand -base64 32
