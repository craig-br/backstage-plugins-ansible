# VM User Credentials (embedded at build time)
# Copy to .credentials.env and edit: cp credentials.env.example .credentials.env
#
# Generate secure passwords using: openssl rand -base64 32

# Admin user account (non-root user with sudo privileges)
# Root password is disabled for security - use admin user with sudo
ADMIN_USER=admin
ADMIN_PASSWORD=<your-secure-admin-password-here>

# SSH configuration
# If you don't have an SSH key, generate one (example):
#   ssh-keygen -t ed25519 -f ~/.ssh/portal_vm_key
#   chmod 600 ~/.ssh/portal_vm_key
#   chmod 644 ~/.ssh/portal_vm_key.pub
# Then copy your public key: cp ~/.ssh/<your-ssh-key-name>.pub files/
SSH_PUBLIC_KEY_FILE=files/<your-ssh-key-name>.pub
SSH_SECURITY_MODE=keys-only

# SSH modes: keys-only (recommended) | keys-and-password | password-only
# Note: Credentials are embedded at build time and cannot be changed without rebuilding

