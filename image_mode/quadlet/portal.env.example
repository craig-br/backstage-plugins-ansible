# Self-Service Automation Portal Configuration
# Copy to .portal.env and edit: cp portal.env.example .portal.env

# =============================================================================
# IMAGE BUILD CONFIGURATION
# =============================================================================
# Image name and tag
IMAGE_NAME=rhaap-portal-image
IMAGE_TAG=latest
# =============================================================================
# REGISTRY CONFIGURATION (optional - only for pushing to registry)
# =============================================================================
REGISTRY=localhost
NAMESPACE=<namespace-name>

# =============================================================================
# VM CONFIGURATION (optional - only for testing VMs)
# =============================================================================
VM_NAME=rhaap-portal-vm
VM_MEMORY=4096
VM_VCPUS=2

# =============================================================================
# CORE CONFIGURATION
# =============================================================================

PORTAL_ENVIRONMENT=production

# Base URL (auto-detected at VM startup, localhost used during build)
BASE_URL=http://localhost:7007

# Backend Secret (generate: openssl rand -base64 32)
BACKEND_SECRET=<your-secure-backend-secret-here>

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
USE_EXTERNAL_POSTGRES=false

# Database connection settings (used by both local and external database)
POSTGRES_HOST=portal-postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<your-secure-database-password-here>
POSTGRES_DB=portal_backstage

# External database configuration (optional - set USE_EXTERNAL_POSTGRES=true)
# Example:
#   USE_EXTERNAL_POSTGRES=true
#   POSTGRES_HOST=<your-database-host.example.com>
#   POSTGRES_USER=<your-database-username>
#   POSTGRES_PASSWORD=<your-database-password-here>
#   BACKEND_DATABASE_CONNECTION_SSL=true

# Local PostgreSQL container settings (used when USE_EXTERNAL_POSTGRES=false)
POSTGRESQL_DATABASE=${POSTGRES_DB}
POSTGRESQL_USER=portal_user
POSTGRESQL_PASSWORD=${POSTGRES_PASSWORD}
POSTGRESQL_ADMIN_PASSWORD=${POSTGRES_PASSWORD}

# Performance tuning (optional)
# POSTGRESQL_MAX_CONNECTIONS=100
# POSTGRESQL_SHARED_BUFFERS=256MB
# POSTGRESQL_EFFECTIVE_CACHE_SIZE=1GB

# =============================================================================
# ANSIBLE AUTOMATION PLATFORM
# =============================================================================

AAP_HOST_URL=https://<your-aap-instance.example.com>
AAP_TOKEN=<your-aap-api-token-here>
OAUTH_CLIENT_ID=<your-oauth-client-id-here>
OAUTH_CLIENT_SECRET=<your-oauth-client-secret-here>

# =============================================================================
# SOURCE CONTROL INTEGRATIONS (optional - only for private repositories)
# =============================================================================

# GitHub integration (optional)
# Required token scopes: repo (for private repos) or public_repo (for public repos only)
GITHUB_URL=https://github.com
GITHUB_TOKEN=ghp_<your-github-token-here>

# GitLab integration (optional)
# Required token scope: read_api
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=glpat-<your-gitlab-token-here>
