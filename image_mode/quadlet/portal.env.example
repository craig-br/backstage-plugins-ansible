# =============================================================================
# Self-Service Automation Portal Configuration
# =============================================================================
#
# SETUP: Copy this file to .portal.env (hidden) and edit with your values
#   cp portal.env.example .portal.env
#   Edit .portal.env in your editor
#
# The hidden .portal.env file is automatically ignored by git.
# =============================================================================

# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================

# Portal environment mode (production or development)
PORTAL_ENVIRONMENT=production

# =============================================================================
# CORE PORTAL CONFIGURATION
# =============================================================================

# TLS certificate validation (set to 0 only for development with self-signed certificates)
NODE_TLS_REJECT_UNAUTHORIZED=1

# Portal URL (auto-detected at startup based on VM's IP address)
BASE_URL=http://localhost:7007

# Node.js configuration
NODE_OPTIONS=--no-node-snapshot

# Authentication Provider Override
ENABLE_AUTH_PROVIDER_MODULE_OVERRIDE=true

# Logging Configuration
# LOG_LEVEL=debug

# Analytics Configuration (Segment)
SEGMENT_WRITE_KEY=gGVM6sYRK0D0ndVX22BOtS7NRcxPej8t

# Backend Authentication Secret
# Generate with: openssl rand -base64 32
BACKEND_SECRET=your-backend-secret-key-here-must-be-set

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Set USE_EXTERNAL_POSTGRES to control which database to use:
#   false = Use local PostgreSQL container (automatic setup)
#   true  = Use external PostgreSQL server (requires setup - see EXTERNAL-POSTGRES-SETUP.md)
# =============================================================================

USE_EXTERNAL_POSTGRES=false

# -----------------------------------------------------------------------------
# DATABASE CONNECTION SETTINGS
# -----------------------------------------------------------------------------
# Edit the section below based on USE_EXTERNAL_POSTGRES setting:

# For local container (USE_EXTERNAL_POSTGRES=false):
POSTGRES_HOST=rhdh-postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_admin_password_123  # Generate: openssl rand -base64 32

# For external database (USE_EXTERNAL_POSTGRES=true):
# Uncomment and edit these lines, then comment out the lines above:
# POSTGRES_HOST=db.example.com
# POSTGRES_USER=rhdh_user
# POSTGRES_PASSWORD=<your-secure-password>

# Common settings (used by both)
POSTGRES_PORT=5432
POSTGRES_DB=rhdh_backstage

BACKEND_DATABASE_CLIENT=pg
BACKEND_DATABASE_CONNECTION_HOST=${POSTGRES_HOST}
BACKEND_DATABASE_CONNECTION_PORT=${POSTGRES_PORT}
BACKEND_DATABASE_CONNECTION_USER=${POSTGRES_USER}
BACKEND_DATABASE_CONNECTION_PASSWORD=${POSTGRES_PASSWORD}
BACKEND_DATABASE_CONNECTION_DATABASE=${POSTGRES_DB}
BACKEND_DATABASE_CONNECTION_SSL=false  # Set to true for external DB with SSL

# PostgreSQL container settings (only used by Option 1 - local container)
POSTGRESQL_DATABASE=${POSTGRES_DB}
POSTGRESQL_USER=rhdh_user
POSTGRESQL_PASSWORD=secure_rhdh_password_123
POSTGRESQL_ADMIN_PASSWORD=${POSTGRES_PASSWORD}
POSTGRESQL_MAX_CONNECTIONS=100
POSTGRESQL_SHARED_BUFFERS=256MB
POSTGRESQL_EFFECTIVE_CACHE_SIZE=1GB

# =============================================================================
# ANSIBLE AUTOMATION PLATFORM INTEGRATION
# =============================================================================

# AAP Server Configuration
AAP_HOST_URL=<AAP_HOST_URL>
AAP_TOKEN=<AAP_TOKEN>

# OAuth Configuration for AAP Authentication
OAUTH_CLIENT_ID=<OAUTH_CLIENT_ID>
OAUTH_CLIENT_SECRET=<OAUTH_CLIENT_SECRET>

# =============================================================================
# EXTERNAL INTEGRATIONS (Optional)
# =============================================================================
# Only required for:
#   - Accessing private repositories
#   - GitHub Enterprise or self-hosted GitLab (change URL)
# Public repositories work without tokens

# GitHub Integration
# Generate token at: https://github.com/settings/tokens
# Required scopes: repo, read:org, read:user, user:email
GITHUB_URL=https://github.com  # Change for GitHub Enterprise
GITHUB_TOKEN=<GITHUB_TOKEN>

# GitLab Integration
# Generate token at: https://gitlab.com/-/profile/personal_access_tokens
# Required scopes: read_api, read_repository, read_user
GITLAB_URL=https://gitlab.com  # Change for self-hosted GitLab
GITLAB_TOKEN=<GITLAB_TOKEN>

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. Change all passwords for production deployments
# 2. Generate strong passwords: openssl rand -base64 32
# 3. POSTGRES_PASSWORD is used by both the portal and PostgreSQL container
# 4. BASE_URL is auto-detected at startup based on VM's IP address
# =============================================================================

