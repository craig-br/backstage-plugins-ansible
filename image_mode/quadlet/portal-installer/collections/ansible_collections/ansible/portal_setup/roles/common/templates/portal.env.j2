# Self-Service Automation Portal Configuration
# Generated by Ansible from inventory variables

# =============================================================================
# CORE CONFIGURATION
# =============================================================================

PORTAL_ENVIRONMENT={{ portal_environment }}

# HTTP listen port
PORTAL_HTTP_PORT={{ portal_http_port }}

# Base URL (auto-detected at VM startup with https://<vm-ip>:<port>)
# During build, localhost is used as placeholder
BASE_URL={{ portal_base_url | default('https://localhost:' + portal_http_port|string) }}

# Backend Secret (generate: openssl rand -base64 32)
BACKEND_SECRET={{ backend_secret }}

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
USE_EXTERNAL_POSTGRES={{ 'true' if postgres_host is defined and postgres_host != 'localhost' else 'false' }}

# Database connection settings
POSTGRES_HOST={{ postgres_host | default('portal-postgres') }}
POSTGRES_PORT={{ postgres_port | default('5432') }}
POSTGRES_USER={{ postgres_user | default('portal_user') }}
POSTGRES_PASSWORD={{ postgres_password }}
POSTGRES_DB={{ postgres_db | default('portal') }}

# Database connection SSL
{% if backend_database_connection_ssl is defined %}
BACKEND_DATABASE_CONNECTION_SSL={{ backend_database_connection_ssl }}
{% endif %}

# Local PostgreSQL container settings (used when USE_EXTERNAL_POSTGRES=false)
POSTGRESQL_DATABASE={{ postgres_db | default('portal') }}
POSTGRESQL_USER=portal_user
POSTGRESQL_PASSWORD={{ postgres_password }}
POSTGRESQL_ADMIN_PASSWORD={{ postgres_password }}

# =============================================================================
# ANSIBLE AUTOMATION PLATFORM
# =============================================================================

AAP_HOST_URL={{ aap_host_url }}
AAP_TOKEN={{ aap_token }}
OAUTH_CLIENT_ID={{ oauth_client_id }}
OAUTH_CLIENT_SECRET={{ oauth_client_secret }}

# =============================================================================
# PORTAL SYNC CONFIGURATION
# =============================================================================

{% if portal_orgs_filter is defined %}
# AAP organizations to synchronize
PORTAL_ORGS_FILTER={{ portal_orgs_filter }}
{% endif %}

# Job template sync settings
PORTAL_JOB_TEMPLATE_SYNC_ENABLED={{ portal_job_template_sync_enabled | default('true') }}
PORTAL_JOB_TEMPLATE_SYNC_MINUTES={{ portal_job_template_sync_minutes | default('60') }}

{% if portal_job_template_survey_enabled is defined %}
# Filter by survey enabled status
PORTAL_JOB_TEMPLATE_SURVEY_ENABLED={{ portal_job_template_survey_enabled }}
{% endif %}

{% if portal_job_template_labels is defined %}
# Filter by job template labels
PORTAL_JOB_TEMPLATE_LABELS={{ portal_job_template_labels | to_json }}
{% endif %}

# Users and teams sync frequency (minutes)
PORTAL_USERS_TEAMS_SYNC_MINUTES={{ portal_users_teams_sync_minutes | default('60') }}

# Sync operation timeout (minutes)
PORTAL_SYNC_TIMEOUT_MINUTES={{ portal_sync_timeout_minutes | default('15') }}

# =============================================================================
# APPLICATION LOGGING
# =============================================================================

LOG_LEVEL={{ portal_log_level | default('info') }}

# =============================================================================
# SOURCE CONTROL INTEGRATIONS (optional)
# =============================================================================

# GitHub integration (defaults to public github.com)
# Override github_url in inventory for GitHub Enterprise
# NOTE: Provide hostname only, not full URL (e.g., 'github.com' not 'https://github.com')
GITHUB_URL={{ github_integration_url }}
{% if github_integration_token | length > 0 %}
GITHUB_TOKEN={{ github_integration_token }}
{% endif %}

# GitLab integration (defaults to public gitlab.com)
# Override gitlab_url in inventory for self-hosted GitLab
# NOTE: Provide hostname only, not full URL (e.g., 'gitlab.com' not 'https://gitlab.com')
GITLAB_URL={{ gitlab_integration_url }}
{% if gitlab_integration_token | length > 0 %}
GITLAB_TOKEN={{ gitlab_integration_token }}
{% endif %}


